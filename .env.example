# Пусто — фронт работает на локальном контуре (Zustand).
# Когда бэкенд готов (см. docs/backend/openapi.yaml):
# NEXT_PUBLIC_API_URL=https://host/api/v1
#
# Публичный адрес сайта — в QR талона и письмах (без завершающего /):
# NEXT_PUBLIC_SITE_URL=https://priem.sot.kg
#
# Локальные учебные данные кабинета (20 заявок) отключаются так:
# NEXT_PUBLIC_DEMO=false
